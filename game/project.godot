; Engine configuration file.
; Roofline — original cinematic side-view parkour runner.
;
; Renderer is gl_compatibility (WebGL2) on every target: the browser is the
; primary platform and Forward+/Mobile require WebGPU, which is not reliably
; available. Do not change this without re-testing the web export.

config_version=5

[application]

config/name="Roofline"
config/description="A cinematic side-view parkour runner. Original work."
config/version="0.1.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.035, 0.04, 0.055, 1)
boot_splash/show_image=false

[autoload]

Game="*res://src/autoload/game.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

