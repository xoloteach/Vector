[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="traversable"
3d_physics/layer_4="hazard"
3d_physics/layer_5="trigger"
3d_physics/layer_6="pursuer"

[physics]

3d/default_gravity=0.0
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.035, 0.04, 0.055, 1)
lights_and_shadows/directional_shadow/size=2048
